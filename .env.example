# Seenzo — environment variables reference.
# Copy to .env.local for local dev (bun dev reads it from this directory),
# and set the same keys in the Vercel project's Environment Variables.
# Never commit a file with real values.

# ---------------------------------------------------------------------------
# Supabase (Mumbai / ap-south-1 project)
# ---------------------------------------------------------------------------

# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Anon/publishable key — RLS-gated, used for public reads (e.g. /r/$slug report page).
# Server-side only in this app (never shipped to the browser bundle).
SUPABASE_PUBLISHABLE_KEY=

# Service-role/secret key — bypasses RLS. Used for all backend writes (scan
# pipeline, lead management, admin dashboard, activity logging). Never expose
# this to the client.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Resend (transactional email)
# ---------------------------------------------------------------------------

# Resend API key. Sender address is hardcoded to reports@seenzo.in — that
# domain must be verified in the Resend dashboard.
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Inngest (background jobs / durable functions)
# ---------------------------------------------------------------------------

# Event key — used by the app to send events into Inngest (scan/requested,
# report/ready, followup/start).
INNGEST_EVENT_KEY=

# Signing key — used by the Inngest SDK to verify inbound requests from
# Inngest Cloud (function execution + registration sync). Read automatically
# from this env var by the SDK; not passed explicitly in code. Required in
# production — without it, calls to /api/inngest cannot be authenticated.
INNGEST_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Upstash Redis (rate limiting)
# ---------------------------------------------------------------------------

# REST API URL for the Upstash Redis database.
UPSTASH_REDIS_REST_URL=

# REST API token for the Upstash Redis database.
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Meta WhatsApp Cloud API
# ---------------------------------------------------------------------------

# Permanent access token for the WhatsApp Business app.
META_WHATSAPP_TOKEN=

# Phone number ID the messages are sent from.
META_WHATSAPP_PHONE_NUMBER_ID=

# Verify token for Meta's inbound webhook handshake (Meta calls back with a
# challenge on this token when you configure the webhook URL in the Meta App
# dashboard). Not yet consumed by any route in this codebase — there is no
# inbound WhatsApp webhook handler built yet — but Meta's setup flow requires
# a value to be configured, so it's provisioned here ahead of that work.
META_WEBHOOK_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# Admin dashboard
# ---------------------------------------------------------------------------

# Credentials for the one-time admin seed script (`bun run seed:admin`),
# which creates the single Supabase Auth admin user. Only read by
# src/lib/server/admin-seed.ts — not needed at app runtime after the admin
# user has been created once. Safe to unset afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Public site URL, no trailing slash. VITE_-prefixed so it's also available
# to client code; used server-side to set the Inngest serveOrigin for the
# Cloud registration handshake (src/routes/api/inngest.ts).
VITE_APP_URL=https://www.seenzo.in
